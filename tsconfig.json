{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": ".",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": [
    "stacks/**/*.ts",
    "bin/**/*.ts",
    "sst-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".sst",
    "templates"
  ]
}
