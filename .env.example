# Provider support in v1.0.0: AWS only
INFRA_PROVIDER=aws

# SST app identity
INFRA_APP_NAME=myapp

# Core domain and repository
INFRA_ROOT_DOMAIN=example.com
INFRA_PIPELINE_REPO=myorg/myrepo
INFRA_PIPELINE_PREFIX=myapp
INFRA_PROJECT_TAG=myapp

# Optional pipeline stages: production,dev,mobile
INFRA_PIPELINES=production,dev
INFRA_PIPELINE_BRANCH_PROD=main
INFRA_PIPELINE_BRANCH_DEV=develop
INFRA_PIPELINE_BRANCH_MOBILE=mobile

# Optional Expo static site deployment
INFRA_ENABLE_EXPO_SITE=false

# Optional explicit domain overrides per stage
INFRA_WEB_DOMAIN_PRODUCTION=example.com
INFRA_WEB_DOMAIN_DEV=dev.example.com
INFRA_WEB_DOMAIN_MOBILE=api.example.com

INFRA_EXPO_DOMAIN_PRODUCTION=mobile.example.com
INFRA_EXPO_DOMAIN_DEV=dev.mobile.example.com
INFRA_EXPO_DOMAIN_MOBILE=preview.mobile.example.com

# Optional existing ACM cert ARNs (leave empty to let SST manage certificates)
INFRA_WEB_CERT_ARN_PRODUCTION=
INFRA_WEB_CERT_ARN_DEV=
INFRA_WEB_CERT_ARN_MOBILE=

INFRA_EXPO_CERT_ARN_PRODUCTION=
INFRA_EXPO_CERT_ARN_DEV=
INFRA_EXPO_CERT_ARN_MOBILE=
